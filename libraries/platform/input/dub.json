{
  "name": "input-events",
  "targetType": "staticLibrary",
  "sourcePaths": [
    "source"
  ],
  "toolchainRequirements": {
    "dmd": ">=2.111.0",
    "ldc": ">=1.41.0"
  },
  "buildTypes": {
    "profile-fp": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "optimize"
      ],
      "dflags-dmd": [
        "-gs"
      ],
      "dflags-ldc": [
        "--frame-pointer=all"
      ]
    },
    "perf": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "perf-count": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "perf-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "unittests"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "check": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--checkaction=C",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "check-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "unittests"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "check-release": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "sanitize": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--fsanitize=address",
        "--fsanitize-address-use-after-return=never",
        "--checkaction=C",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "sanitize-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "unittests"
      ],
      "dflags-ldc": [
        "--fsanitize=address",
        "--fsanitize-address-use-after-return=never",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "tsan": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--fsanitize=thread",
        "--enable-asserts=false",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest",
        "SanitizerThreadPreinit"
      ]
    }
  },
  "dependencies": {
    "bindbc-sdl": "~>1.5.2",
    "dyaml": {
      "version": "22e4724474795eefb64ee9742f980b49bb34f6ef",
      "repository": "git+https://github.com/shulc/D-YAML.git"
    },
    "vibe3d:log": {
      "path": "../../.."
    }
  },
  "versions": [
    "SDL_2020"
  ],
  "configurations": [
    {
      "name": "modeling",
      "versions": [
        "WithAI"
      ],
      "subConfigurations": {
        "vibe3d:log": "modeling"
      }
    },
    {
      "name": "modeling-noai",
      "versions": [],
      "subConfigurations": {
        "vibe3d:log": "modeling-noai"
      }
    },
    {
      "name": "with-render",
      "versions": [
        "WithRender",
        "WithAI"
      ],
      "subConfigurations": {
        "vibe3d:log": "with-render"
      }
    },
    {
      "name": "web",
      "versions": [
        "web"
      ],
      "subConfigurations": {
        "bindbc-sdl": "static",
        "vibe3d:log": "web"
      }
    },
    {
      "name": "root-tests",
      "versions": [
        "WithAI"
      ],
      "subConfigurations": {
        "vibe3d:log": "root-tests"
      },
      "targetType": "sourceLibrary"
    },
    {
      "name": "isolated-tests",
      "versions": [],
      "subConfigurations": {
        "vibe3d:log": "isolated-tests"
      },
      "targetType": "sourceLibrary"
    }
  ],
  "targetName": "vibe3d-input-events",
  "targetPath": ".",
  "importPaths": [
    "source"
  ]
}
