{
  "name": "vibe3d-mesh-snapshot-tests",
  "targetType": "executable",
  "toolchainRequirements": {
    "dmd": ">=2.111.0",
    "ldc": ">=1.41.0"
  },
  "buildTypes": {
    "profile-fp": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "optimize"
      ],
      "dflags-dmd": [
        "-gs"
      ],
      "dflags-ldc": [
        "--frame-pointer=all"
      ]
    },
    "perf": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "perf-count": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "perf-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "unittests"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "check": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--checkaction=C",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "check-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "unittests"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "check-release": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "sanitize": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--fsanitize=address",
        "--fsanitize-address-use-after-return=never",
        "--checkaction=C",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "sanitize-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "unittests"
      ],
      "dflags-ldc": [
        "--fsanitize=address",
        "--fsanitize-address-use-after-return=never",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "tsan": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--fsanitize=thread",
        "--enable-asserts=false",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest",
        "SanitizerThreadPreinit"
      ]
    }
  },
  "sourcePaths": [],
  "sourceFiles": [
    "../source/vibe3d/mesh/snapshot/snapshot.d",
    "source/vibe3d/mesh/snapshot/tests/unit/mesh_map_kind_snapshot_test.d",
    "source/vibe3d/mesh/snapshot/tests/unit/mesh_selsets_snapshot_test.d",
    "source/vibe3d/mesh/snapshot/tests/unit/mesh_wire_snapshot_test.d",
    "source/vibe3d/mesh/snapshot/tests/unit/snapshot_test.d"
  ],
  "importPaths": [
    "../source",
    "source"
  ],
  "dflags": [],
  "dependencies": {
    "vibe3d:mesh": {
      "path": "../../../.."
    },
    "vibe3d:mesh-change": {
      "path": "../../../.."
    },
    "vibe3d:math": {
      "path": "../../../.."
    },
    "vibe3d:profiling": {
      "path": "../../../.."
    },
    "vibe3d:plane-bytes": {
      "path": "../../../.."
    }
  },
  "configurations": [
    {
      "name": "algorithm",
      "subConfigurations": {
        "vibe3d:mesh": "snapshot-fixtures",
        "vibe3d:mesh-change": "isolated-tests",
        "vibe3d:math": "isolated-tests",
        "vibe3d:profiling": "isolated-tests",
        "vibe3d:plane-bytes": "isolated-tests"
      }
    }
  ]
}
