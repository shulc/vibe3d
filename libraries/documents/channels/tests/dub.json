{
  "name": "vibe3d-document-channels-tests",
  "targetType": "executable",
  "sourcePaths": [],
  "toolchainRequirements": {
    "dmd": ">=2.111.0",
    "ldc": ">=1.41.0"
  },
  "buildTypes": {
    "profile-fp": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "optimize"
      ],
      "dflags-dmd": [
        "-gs"
      ],
      "dflags-ldc": [
        "--frame-pointer=all"
      ]
    },
    "perf": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "perf-count": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "perf-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "unittests"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "check": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--checkaction=C",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "check-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "unittests"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "check-release": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "sanitize": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--fsanitize=address",
        "--fsanitize-address-use-after-return=never",
        "--checkaction=C",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "sanitize-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "unittests"
      ],
      "dflags-ldc": [
        "--fsanitize=address",
        "--fsanitize-address-use-after-return=never",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "tsan": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--fsanitize=thread",
        "--enable-asserts=false",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest",
        "SanitizerThreadPreinit"
      ]
    }
  },
  "dependencies": {
    "vibe3d:document-model": {
      "path": "../../../.."
    },
    "vibe3d:param-schema": {
      "path": "../../../.."
    },
    "vibe3d:edit-contracts": {
      "path": "../../../.."
    },
    "vibe3d:math": {
      "path": "../../../.."
    },
    "vibe3d:mesh": {
      "path": "../../../.."
    }
  },
  "importPaths": [
    "source",
    "../source"
  ],
  "configurations": [
    {
      "name": "algorithm",
      "subConfigurations": {
        "vibe3d:document-model": "isolated-tests",
        "vibe3d:param-schema": "isolated-tests",
        "vibe3d:edit-contracts": "isolated-tests",
        "vibe3d:math": "isolated-tests",
        "vibe3d:mesh": "isolated-tests"
      }
    }
  ],
  "sourceFiles": [
    "../source/vibe3d/documents/channels/layer_params.d",
    "source/vibe3d/documents/channels/tests/unit/document_channels_population_test.d",
    "source/vibe3d/documents/channels/tests/unit/layer_params_test.d"
  ],
  "dflags": []
}
