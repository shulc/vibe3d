{
  "name": "command-runtime",
  "description": "Command and history runtime",
  "license": "MIT",
  "targetType": "staticLibrary",
  "sourcePaths": [
    "source"
  ],
  "dependencies": {
    "vibe3d:camera-model": {
      "path": "../../../.."
    },
    "vibe3d:document-model": {
      "path": "../../../.."
    },
    "vibe3d:edit-contracts": {
      "path": "../../../.."
    },
    "vibe3d:mesh": {
      "path": "../../../.."
    },
    "vibe3d:mesh-change": {
      "path": "../../../.."
    },
    "vibe3d:mesh-edit-log": {
      "path": "../../../.."
    },
    "vibe3d:mesh-edit-replay": {
      "path": "../../../.."
    },
    "vibe3d:mesh-ops": {
      "path": "../../../.."
    },
    "vibe3d:mesh-snapshot": {
      "path": "../../../.."
    },
    "vibe3d:param-schema": {
      "path": "../../../.."
    },
    "vibe3d:pipe-contracts": {
      "path": "../../../.."
    },
    "vibe3d:pipe-runtime": {
      "path": "../../../.."
    },
    "vibe3d:profiling": {
      "path": "../../../.."
    },
    "vibe3d:spatial": {
      "path": "../../../.."
    },
    "vibe3d:math": {
      "path": "../../../.."
    }
  },
  "toolchainRequirements": {
    "dmd": ">=2.111.0",
    "ldc": ">=1.41.0"
  },
  "buildTypes": {
    "profile-fp": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "optimize"
      ],
      "dflags-dmd": [
        "-gs"
      ],
      "dflags-ldc": [
        "--frame-pointer=all"
      ]
    },
    "perf": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "perf-count": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "perf-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "check": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--checkaction=C",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "check-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "check-release": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "sanitize": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--fsanitize=address",
        "--fsanitize-address-use-after-return=never",
        "--checkaction=C",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "sanitize-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--fsanitize=address",
        "--fsanitize-address-use-after-return=never",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "tsan": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--fsanitize=thread",
        "--enable-asserts=false",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest",
        "SanitizerThreadPreinit"
      ]
    }
  },
  "configurations": [
