{
  "name": "selection-model",
  "description": "Selection values and projections",
  "license": "MIT",
  "targetType": "staticLibrary",
  "sourcePaths": [
    "source"
  ],
  "dependencies": {
    "vibe3d:document-model": {
      "path": "../../../.."
    },
    "vibe3d:edit-contracts": {
      "path": "../../../.."
    },
    "vibe3d:mesh": {
      "path": "../../../.."
    }
  },
  "toolchainRequirements": {
    "dmd": ">=2.111.0",
    "ldc": ">=1.41.0"
  },
  "buildTypes": {
    "profile-fp": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "optimize"
      ],
      "dflags-dmd": [
        "-gs"
      ],
      "dflags-ldc": [
        "--frame-pointer=all"
      ]
    },
    "perf": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "perf-count": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "perf-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "unittests"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "check": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--checkaction=C",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "check-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "unittests"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "check-release": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "sanitize": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--fsanitize=address",
        "--fsanitize-address-use-after-return=never",
        "--checkaction=C",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "sanitize-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "unittests"
      ],
      "dflags-ldc": [
        "--fsanitize=address",
        "--fsanitize-address-use-after-return=never",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "tsan": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--fsanitize=thread",
        "--enable-asserts=false",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest",
        "SanitizerThreadPreinit"
      ]
    }
  },
  "configurations": [
    {
      "name": "modeling",
      "versions": [
        "WithAI"
      ],
      "subConfigurations": {
        "vibe3d:document-model": "modeling",
        "vibe3d:edit-contracts": "modeling",
        "vibe3d:mesh": "modeling"
      }
    },
    {
      "name": "modeling-noai",
      "versions": [],
      "subConfigurations": {
        "vibe3d:document-model": "modeling-noai",
        "vibe3d:edit-contracts": "modeling-noai",
        "vibe3d:mesh": "modeling-noai"
      }
    },
    {
      "name": "with-render",
      "versions": [
        "WithRender",
        "WithAI"
      ],
      "subConfigurations": {
        "vibe3d:document-model": "with-render",
        "vibe3d:edit-contracts": "with-render",
        "vibe3d:mesh": "with-render"
      }
    },
    {
      "name": "web",
      "versions": [
        "web"
      ],
      "subConfigurations": {
        "vibe3d:document-model": "web",
        "vibe3d:edit-contracts": "web",
        "vibe3d:mesh": "web"
      }
    },
    {
      "name": "root-tests",
      "versions": [
        "WithAI",
        "MeshSnapshotFixtures"
      ],
      "subConfigurations": {
        "vibe3d:document-model": "root-tests",
        "vibe3d:edit-contracts": "root-tests",
        "vibe3d:mesh": "root-tests"
      },
      "targetType": "sourceLibrary"
    },
    {
      "name": "isolated-tests",
      "versions": [],
      "subConfigurations": {
        "vibe3d:document-model": "isolated-tests",
        "vibe3d:edit-contracts": "isolated-tests",
        "vibe3d:mesh": "isolated-tests"
      },
      "targetType": "sourceLibrary"
    }
  ],
  "targetName": "vibe3d-selection-model",
  "targetPath": ".",
  "importPaths": [
    "source"
  ]
}
