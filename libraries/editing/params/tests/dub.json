{
  "name": "vibe3d-param-schema-tests",
  "license": "MIT",
  "targetType": "executable",
  "sourcePaths": [],
  "importPaths": [
    "source",
    "../source"
  ],
  "sourceFiles": [
    "../source/vibe3d/editing/params/argstring.d",
    "../source/vibe3d/editing/params/params.d",
