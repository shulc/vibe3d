  "workingDirectory": "../../../../",
  "dflags": [],
  "toolchainRequirements": {
    "dmd": ">=2.111.0",
    "ldc": ">=1.41.0"
  },
  "buildTypes": {
    "profile-fp": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "optimize"
