.DS_Store
.vscode/
# .claude is a gitignored symlink to local private notes.
/.claude
# Local agent instructions — symlinked to private notes, not published.
/AGENTS.md
dub.selections.json
events.log
imgui.ini
/vibe3d
vibe3d-test-library
vibe3d-test-modeling
vibe3d-test-tests
vibe3d-test-with-render
# Task 1410 — the instrumented buildTypes. dub 1.41 IGNORES a per-buildType
# `targetName` (measured), so every instrumented build writes ./vibe3d and
# tools/sanitizer/lane.d immediately renames it to one of these. They are
# 32-49 MB build artifacts in a workspace the nightly lanes deliberately keep
# unclean (`clean: false`), which is exactly where an untracked binary gets
# swept into a commit by a stray `git add -A`.
vibe3d-check
vibe3d-check-unit
vibe3d-check-release
vibe3d-sanitize
vibe3d-release
vibe3d-plain
sanitizer-boot-*.log
asan-report.*
asan-fuzz.*
/.dub-sanitizer/
/fuzz-out/
# Task 1411 — the ThreadSanitizer lane. Same reasoning as the block above, plus
# one of its own: this lane WRITES ITS EVIDENCE INTO THE WORKSPACE (TSAN_OPTIONS
# log_path, the sweep sentinel, the RSS series). Those files are read by
# `lane.d tsan-verdict` in the same job and uploaded as artifacts; they must not
# become a commit.
vibe3d-tsan
vibe3d-debug
tsan-report-*
tsan-instance-*.log
tsan-sweep*.done
tsan-rss-*.csv
/.dub-tsan/
*.dll
*.o
__pycache__/
*.py[cod]
run.log
vibe3d.pdb
vibe3d.exe
vibe3d.app/
.dub/version.json
install.cmd
run_render.ps1
# Local QA tooling (reference comparison against external engines) —
# kept on disk for local parity checks, not published. No trailing slash so
# the rule also matches a symlink at this path (symlinks to a private repo).
/tools/local
# Local dev guidance for Claude Code — kept on disk, not published.
CLAUDE.md
# Internal design / planning docs — kept on disk, not published.
# No trailing slash so the rule also matches a symlink at this path.
/doc
# RPR runtime kernel cache + logs (created next to vibe3d.exe at runtime)
cache/
tahoenext.log
# Release artifacts
vibe3d-*.zip
vibe3d-windows-render/
vibe3d-linux-render/
vibe3d-macos-render/
# Self-contained Linux AppImage + its build cache (downloaded packaging tools,
# staged AppDir) — produced by tools/release/bundle_linux_appimage.sh.
*.AppImage
/tools/release/.appimage-build/

# Per-test wall-clock timing cache used by run_test.d's LPT scheduler.
# Machine-specific (durations depend on the host), so not published.
.test_timings.json

# perf harness generated output (results.json is a transient per-run dump;
# baseline.json is committed as the reference — see tools/perf/README.md)
tools/perf/results.json

# `frames` subcommand (task 0195) generated output — mirrors results.json
# above; frames_baseline.json is the committed reference (mirrors
# baseline.json), frames_results.json is the transient per-run dump.
tools/perf/frames_results.json

# `tools` subcommand (task 1370) generated output — the per-run dump of one
# preview rebuild's cost. Transient like the two above; this lane has NO
# committed baseline (it gates on machine-stable counts, not on a budget), so
# there is no committed sibling file here.
tools/perf/tools_results.json
tools/perf/viewport_results.json

# Per-host run history (task 0197 — perf tooling consolidation): one JSONL
# per host, appended to by every `ops`/`frames` run. Machine-specific (like
# .test_timings.json above), read by `--trend`.
tools/perf/history/

# `flame` subcommand generated output (task 0197) — perf.data/perf.txt/
# folded stacks, mirrors the retired tools/perf_subpatch/out/.
tools/perf/flame/out/

# The retired one-off profiling scratch dirs the line above refers to. They were
# named but never ignored, so a `git add -A` sweeps in a 177 MB perf.data and the
# push is rejected by the file-size limit — which is how this entry came to be.
tools/perf_subpatch/out/
tools/perf_mesh_faces/run

# Ad-hoc test binaries built beside the tracked ones. `vibe3d-test-modeling`
# above does not cover a suffixed variant.
vibe3d-test-modeling-*
vibe3d-test-tests-*

# dyaml 0.10.0 unittests (compiled into -unittest test binaries via
# test_forms_loader) write a scratch example.yaml into cwd (loader.d:248)
/example.yaml

# graphify knowledge-graph build output (generated by `graphify update`)
graphify-out/
toolcards/

# setuptools build artifacts from `pip install tools/ai3d_worker` — the AI-3D
# installer builds the worker package IN PLACE from the shipped source tree
# (install_linux.sh / install_windows.ps1 step 7), which drops these next to it.
tools/ai3d_worker/build/
tools/ai3d_worker/*.egg-info/

# Vendored nfde (task 0431) build artifacts: the CMake/Ninja build of
# nativefiledialog-extended (out/), dub's static-lib output (bin/), and dub's
# per-package cache (.dub/). The vendored SOURCES are tracked; these are
# regenerated by preBuildCommands when dub rebuilds the package.
#
# stb_image had entries here too until task 0662 moved it out to the
# d-stb-image shim. Nothing replaces them: as a git dependency its CMake
# build lands in the dub package cache, not in this workspace.
third_party/nfde/nativefiledialog-extended/out/
third_party/nfde/bin/
third_party/nfde/.dub/
.vibe3d.buildstamp

# task 3960 — build_check.sh writes the ENVIRONMENT/SOURCE class here for the
# final CI gate step to read; it is a per-run artefact, never committed.
build_class.txt
/.build/
.gesture-lane/
scratch/*.log
scratch/*.lock

