{
  "name": "vibe3d-platform-file-tests",
  "targetType": "executable",
  "sourcePaths": [],
  "sourceFiles": [
    "../source/io/browser_pick_resume.d",
    "../source/io/file_dialog.d",
    "../source/io/file_dialog_browser.d",
    "../source/ui/discard_guard.d"
  ],
  "importPaths": [
    "source",
    "../source"
  ],
  "toolchainRequirements": {
    "dmd": ">=2.111.0",
    "ldc": ">=1.41.0"
  },
  "buildTypes": {
    "profile-fp": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "optimize"
      ],
      "dflags-dmd": [
        "-gs"
      ],
      "dflags-ldc": [
        "--frame-pointer=all"
      ]
    },
    "perf": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "perf-count": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "perf-unit": {
      "buildOptions": [
        "unittests",
        "debugMode",
        "debugInfo"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "check": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--checkaction=C",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "check-unit": {
      "buildOptions": [
        "unittests",
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "check-release": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "sanitize": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--fsanitize=address",
        "--fsanitize-address-use-after-return=never",
        "--checkaction=C",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "sanitize-unit": {
      "buildOptions": [
        "unittests",
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--fsanitize=address",
        "--fsanitize-address-use-after-return=never",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "tsan": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--fsanitize=thread",
        "--enable-asserts=false",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest",
        "SanitizerThreadPreinit"
      ]
    }
  },
  "dependencies": {
    "vibe3d-application-core": {
      "path": "../../application-core"
    },
    "vibe3d-command-runtime": {
      "path": "../../command-runtime"
    },
    "vibe3d-document-io": {
      "path": "../../document-io"
    },
    "vibe3d:edit-contracts": {
      "path": "../../.."
    },
    "vibe3d-interchange": {
      "path": "../../interchange"
    },
    "vibe3d-mesh": {
      "path": "../../mesh"
    },
    "nfde": {
      "path": "../../../third_party/nfde"
    }
  },
  "dflags": [],
  "configurations": [
    {
      "name": "algorithm",
      "subConfigurations": {
        "vibe3d-application-core": "isolated-tests",
        "vibe3d-command-runtime": "isolated-tests",
        "vibe3d-document-io": "isolated-tests",
        "vibe3d:edit-contracts": "isolated-tests",
        "vibe3d-interchange": "isolated-tests",
        "vibe3d-mesh": "isolated-tests"
      }
    }
  ]
}
