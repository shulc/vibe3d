{
    "name": "vibe3d-remesh-runtime-tests",
    "targetType": "executable",
    "sourcePaths": [],
    "sourceFiles": [
        "../source/remesh/region_stitch.d",
        "../source/remesh/remesh_job.d",
        "source/tests/unit/remesh/remesh_job_source_public_test.d",
        "source/tests/unit/remesh/remesh_job_test.d"
    ],
    "importPaths": [
        "source",
        "../source"
    ],
    "toolchainRequirements": {
        "dmd": ">=2.111.0",
        "ldc": ">=1.41.0"
    },
    "buildTypes": {
        "profile-fp": {
            "buildOptions": [
                "debugMode",
                "debugInfo",
                "optimize"
            ],
            "dflags-dmd": [
                "-gs"
            ],
            "dflags-ldc": [
                "--frame-pointer=all"
            ]
        },
        "perf": {
            "buildOptions": [
                "releaseMode",
                "optimize",
                "inline"
            ],
            "versions": [
                "PerfProbe"
            ]
        },
        "perf-count": {
            "buildOptions": [
                "debugMode",
                "debugInfo"
            ],
            "versions": [
                "PerfProbe"
            ]
        },
        "perf-unit": {
            "buildOptions": [
                "unittests",
                "debugMode",
                "debugInfo"
            ],
            "versions": [
                "PerfProbe"
            ]
        },
        "check": {
            "buildOptions": [
                "debugMode",
                "debugInfo"
            ],
            "dflags-ldc": [
                "--boundscheck=on",
                "--checkaction=C",
                "--frame-pointer=all"
            ],
            "versions": [
                "SanitizerSelfTest"
            ]
        },
        "check-unit": {
            "buildOptions": [
                "unittests",
                "debugMode",
                "debugInfo"
            ],
            "dflags-ldc": [
                "--boundscheck=on",
                "--frame-pointer=all"
            ],
            "versions": [
                "SanitizerSelfTest"
            ]
        },
        "check-release": {
            "buildOptions": [
                "releaseMode",
                "optimize",
                "inline",
                "debugInfo"
            ],
            "dflags-ldc": [
                "--boundscheck=on",
                "--frame-pointer=all"
            ],
            "versions": [
                "SanitizerSelfTest"
            ]
        },
        "sanitize": {
            "buildOptions": [
                "debugMode",
                "debugInfo"
            ],
            "dflags-ldc": [
                "--fsanitize=address",
                "--fsanitize-address-use-after-return=never",
                "--checkaction=C",
                "--frame-pointer=all"
            ],
            "versions": [
                "SanitizerSelfTest"
            ]
        },
        "sanitize-unit": {
            "buildOptions": [
                "unittests",
                "debugMode",
                "debugInfo"
            ],
            "dflags-ldc": [
                "--fsanitize=address",
                "--fsanitize-address-use-after-return=never",
                "--frame-pointer=all"
            ],
            "versions": [
                "SanitizerSelfTest"
            ]
        },
        "tsan": {
            "buildOptions": [
                "debugMode",
                "debugInfo"
            ],
            "dflags-ldc": [
                "--fsanitize=thread",
                "--enable-asserts=false",
                "--frame-pointer=all"
            ],
            "versions": [
                "SanitizerSelfTest",
                "SanitizerThreadPreinit"
            ]
        }
    },
    "dependencies": {
        "vibe3d-math": {
            "path": "../../../util/math"
        },
        "vibe3d-mesh": {
            "path": "../../mesh"
        },
        "vibe3d-mesh-change": {
            "path": "../../mesh-change"
        }
    },
    "dflags": [],
    "configurations": [
        {
            "name": "algorithm",
            "subConfigurations": {
                "vibe3d-math": "isolated-tests",
                "vibe3d-mesh": "isolated-tests",
                "vibe3d-mesh-change": "isolated-tests"
            }
        }
    ]
}
