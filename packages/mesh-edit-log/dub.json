{
  "name": "vibe3d-mesh-edit-log",
  "targetType": "staticLibrary",
  "sourcePaths": [
    "source"
  ],
  "toolchainRequirements": {
    "dmd": ">=2.111.0",
    "ldc": ">=1.41.0"
  },
  "buildTypes": {
    "profile-fp": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "optimize"
      ],
      "dflags-dmd": [
        "-gs"
      ],
      "dflags-ldc": [
        "--frame-pointer=all"
      ]
    },
    "perf": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "perf-count": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "perf-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "unittests"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "check": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--checkaction=C",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "check-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "unittests"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "check-release": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "sanitize": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--fsanitize=address",
        "--fsanitize-address-use-after-return=never",
        "--checkaction=C",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "sanitize-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "unittests"
      ],
      "dflags-ldc": [
        "--fsanitize=address",
        "--fsanitize-address-use-after-return=never",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "tsan": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--fsanitize=thread",
        "--enable-asserts=false",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest",
        "SanitizerThreadPreinit"
      ]
    }
  },
  "dependencies": {
    "vibe3d:math": {
      "path": "../.."
    },
    "vibe3d:plane-bytes": {
      "path": "../.."
    },
    "vibe3d:mesh-contracts": {
      "path": "../.."
    },
    "vibe3d:mesh-change": {
      "path": "../.."
    }
  },
  "configurations": [
    {
      "name": "modeling",
      "versions": [
        "WithAI"
      ],
      "subConfigurations": {
        "vibe3d:math": "modeling",
        "vibe3d:plane-bytes": "modeling",
        "vibe3d:mesh-contracts": "modeling",
        "vibe3d:mesh-change": "modeling"
      }
    },
    {
      "name": "modeling-noai",
      "versions": [],
      "subConfigurations": {
        "vibe3d:math": "modeling-noai",
        "vibe3d:plane-bytes": "modeling-noai",
        "vibe3d:mesh-contracts": "modeling-noai",
        "vibe3d:mesh-change": "modeling-noai"
      }
    },
    {
      "name": "with-render",
      "versions": [
        "WithAI",
        "WithRender"
      ],
      "subConfigurations": {
        "vibe3d:math": "with-render",
        "vibe3d:plane-bytes": "with-render",
        "vibe3d:mesh-contracts": "with-render",
        "vibe3d:mesh-change": "with-render"
      }
    },
    {
      "name": "web",
      "versions": [
        "web"
      ],
      "subConfigurations": {
        "vibe3d:math": "web",
        "vibe3d:plane-bytes": "web",
        "vibe3d:mesh-contracts": "web",
        "vibe3d:mesh-change": "web"
      }
    },
    {
      "name": "root-tests",
      "versions": [],
      "targetType": "sourceLibrary",
      "subConfigurations": {
        "vibe3d:math": "root-tests",
        "vibe3d:plane-bytes": "root-tests",
        "vibe3d:mesh-contracts": "root-tests",
        "vibe3d:mesh-change": "root-tests"
      }
    },
    {
      "name": "isolated-tests",
      "versions": [],
      "targetType": "sourceLibrary",
      "subConfigurations": {
        "vibe3d:math": "isolated-tests",
        "vibe3d:plane-bytes": "isolated-tests",
        "vibe3d:mesh-contracts": "isolated-tests",
        "vibe3d:mesh-change": "isolated-tests"
      }
    }
  ]
}
