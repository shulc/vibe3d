{
  "name": "vibe3d-scene-query",
  "description": "Scene geometry queries",
  "license": "MIT",
  "targetType": "staticLibrary",
  "sourcePaths": [
    "source"
  ],
  "dependencies": {
    "d-bvh": {
      "version": "e1a8f41501f94a28dbac99efbea850ed098fa728",
      "repository": "git+https://github.com/shulc/D-BVH.git"
    },
    "vibe3d:edit-contracts": {
      "path": "../.."
    },
    "vibe3d-interaction-query": {
      "path": "../interaction-query"
    },
    "vibe3d-mesh": {
      "path": "../mesh"
    },
    "vibe3d-mesh-preview": {
      "path": "../mesh-preview"
    },
    "vibe3d-pipe-contracts": {
      "path": "../pipe-contracts"
    },
    "vibe3d-pipe-evaluation": {
      "path": "../pipe-evaluation"
    },
    "vibe3d-pipe-runtime": {
      "path": "../pipe-runtime"
    },
    "vibe3d:profiling": {
      "path": "../.."
    },
    "vibe3d:spatial": {
      "path": "../.."
    },
    "vibe3d-viewport-gpu": {
      "path": "../viewport-gpu"
    },
    "vibe3d:math": {
      "path": "../.."
    }
  },
  "toolchainRequirements": {
    "dmd": ">=2.111.0",
    "ldc": ">=1.41.0"
  },
  "buildTypes": {
    "profile-fp": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "optimize"
      ],
      "dflags-dmd": [
        "-gs"
      ],
      "dflags-ldc": [
        "--frame-pointer=all"
      ]
    },
    "perf": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "perf-count": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "perf-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "unittests"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "check": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--checkaction=C",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "check-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "unittests"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "check-release": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "sanitize": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--fsanitize=address",
        "--fsanitize-address-use-after-return=never",
        "--checkaction=C",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "sanitize-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "unittests"
      ],
      "dflags-ldc": [
        "--fsanitize=address",
        "--fsanitize-address-use-after-return=never",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "tsan": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--fsanitize=thread",
        "--enable-asserts=false",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest",
        "SanitizerThreadPreinit"
      ]
    }
  },
  "configurations": [
    {
