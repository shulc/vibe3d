{
  "name": "vibe3d-transform-ops",
  "description": "Transform operation kernels and values",
  "license": "MIT",
  "targetType": "staticLibrary",
  "sourcePaths": [
    "source"
  ],
  "dependencies": {
    "vibe3d-common": {
      "path": "../common"
    },
    "vibe3d-interaction-query": {
      "path": "../interaction-query"
    }
  },
  "toolchainRequirements": {
    "dmd": ">=2.111.0",
    "ldc": ">=1.41.0"
  },
  "buildTypes": {
    "profile-fp": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "optimize"
      ],
      "dflags-dmd": [
        "-gs"
      ],
      "dflags-ldc": [
        "--frame-pointer=all"
      ]
    },
    "perf": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "perf-count": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "perf-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "unittests"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "check": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--checkaction=C",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "check-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "unittests"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "check-release": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "sanitize": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--fsanitize=address",
        "--fsanitize-address-use-after-return=never",
        "--checkaction=C",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "sanitize-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "unittests"
      ],
      "dflags-ldc": [
        "--fsanitize=address",
        "--fsanitize-address-use-after-return=never",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "tsan": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--fsanitize=thread",
        "--enable-asserts=false",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest",
        "SanitizerThreadPreinit"
      ]
    }
  },
  "configurations": [
    {
      "name": "modeling",
      "versions": [
        "WithAI"
      ],
      "subConfigurations": {
        "vibe3d-common": "modeling",
        "vibe3d-interaction-query": "modeling"
      }
    },
    {
      "name": "modeling-noai",
      "versions": [],
      "subConfigurations": {
        "vibe3d-common": "modeling-noai",
        "vibe3d-interaction-query": "modeling-noai"
      }
    },
    {
      "name": "with-render",
      "versions": [
        "WithRender",
        "WithAI"
      ],
      "subConfigurations": {
        "vibe3d-common": "with-render",
        "vibe3d-interaction-query": "with-render"
      }
    },
    {
      "name": "web",
      "versions": [
        "web"
      ],
      "subConfigurations": {
        "vibe3d-common": "web",
        "vibe3d-interaction-query": "web"
      }
    },
    {
      "name": "root-tests",
      "versions": [
        "WithAI"
      ],
      "subConfigurations": {
        "vibe3d-common": "root-tests",
        "vibe3d-interaction-query": "root-tests"
      },
      "targetType": "sourceLibrary"
    }
  ]
}
