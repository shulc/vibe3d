{
  "name": "vibe3d-common",
  "description": "Document model and command operations",
  "license": "MIT",
  "targetType": "staticLibrary",
  "sourcePaths": [
    "source"
  ],
  "dependencies": {
    "d-stb-image": {
      "version": "a66f6917718ea128076a2c5660e37f362a785144",
      "repository": "git+https://github.com/shulc/D-StbImage.git"
    },
    "vibe3d-mesh-edit-log": {
      "path": "../mesh-edit-log"
    },
    "vibe3d-spatial": {
      "path": "../spatial"
    },
    "vibe3d-mesh": {
      "path": "../mesh"
    },
    "vibe3d-edit-contracts": {
      "path": "../edit-contracts"
    },
    "vibe3d-mesh-change": {
      "path": "../mesh-change"
    },
    "vibe3d-math": {
      "path": "../../util/math"
    },
    "vibe3d-log": {
      "path": "../../util/log"
    },
    "vibe3d-mesh-edit-replay": {
      "path": "../mesh-edit-replay"
    },
    "vibe3d-profiling": {
      "path": "../profiling"
    },
    "vibe3d-mesh-snapshot": {
      "path": "../mesh-snapshot"
    },
    "vibe3d-json-number": {
      "path": "../../util/json-number"
    },
    "vibe3d-pipe-contracts": {
      "path": "../pipe-contracts"
    },
    "vibe3d-mesh-preview": {
      "path": "../mesh-preview"
    },
    "vibe3d-mesh-ops": {
      "path": "../mesh-ops"
    }
  },
  "toolchainRequirements": {
    "dmd": ">=2.111.0",
    "ldc": ">=1.41.0"
  },
  "buildTypes": {
    "profile-fp": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "optimize"
      ],
      "dflags-dmd": [
        "-gs"
      ],
      "dflags-ldc": [
        "--frame-pointer=all"
      ]
    },
    "perf": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "perf-count": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "perf-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "check": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--checkaction=C",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "check-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "check-release": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "sanitize": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--fsanitize=address",
        "--fsanitize-address-use-after-return=never",
        "--checkaction=C",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "sanitize-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--fsanitize=address",
        "--fsanitize-address-use-after-return=never",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "tsan": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--fsanitize=thread",
        "--enable-asserts=false",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest",
        "SanitizerThreadPreinit"
      ]
    }
  },
  "configurations": [
