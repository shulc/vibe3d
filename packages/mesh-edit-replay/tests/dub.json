{
  "name": "vibe3d-mesh-edit-replay-tests",
  "targetType": "executable",
  "toolchainRequirements": {
    "dmd": ">=2.111.0",
    "ldc": ">=1.41.0"
  },
  "buildTypes": {
    "profile-fp": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "optimize"
      ],
      "dflags-dmd": [
        "-gs"
      ],
      "dflags-ldc": [
        "--frame-pointer=all"
      ]
    },
    "perf": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "perf-count": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "perf-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "unittests"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "check": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--checkaction=C",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "check-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "unittests"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "check-release": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "sanitize": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--fsanitize=address",
        "--fsanitize-address-use-after-return=never",
        "--checkaction=C",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "sanitize-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "unittests"
      ],
      "dflags-ldc": [
        "--fsanitize=address",
        "--fsanitize-address-use-after-return=never",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "tsan": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--fsanitize=thread",
        "--enable-asserts=false",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest",
        "SanitizerThreadPreinit"
      ]
    }
  },
  "sourcePaths": [],
  "sourceFiles": [
    "../source/mesh_edit_replay.d",
    "source/mesh_edit_replay_roundtrip_test.d",
    "source/tests/unit/mesh_edit_delta_test.d",
    "source/tests/unit/mesh_selsets_replay_test.d"
  ],
  "importPaths": [
    "../source",
    "source"
  ],
  "dflags": [],
  "dependencies": {
    "vibe3d-mesh": {
      "path": "../../mesh"
    },
    "vibe3d-mesh-edit-log": {
      "path": "../../mesh-edit-log"
    },
    "vibe3d-mesh-contracts": {
      "path": "../../mesh-contracts"
    },
    "vibe3d-mesh-change": {
      "path": "../../mesh-change"
    },
    "vibe3d:math": {"path": "../../.."}
  },
  "configurations": [
    {
      "name": "algorithm",
      "subConfigurations": {
        "vibe3d-mesh": "isolated-tests",
        "vibe3d-mesh-edit-log": "isolated-tests",
        "vibe3d-mesh-contracts": "isolated-tests",
        "vibe3d-mesh-change": "isolated-tests",
        "vibe3d:math": "isolated-tests"
      }
    }
  ]
}
