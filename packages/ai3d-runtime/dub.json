{
    "name": "vibe3d-ai3d-runtime",
    "targetType": "staticLibrary",
    "sourcePaths": [
        "source"
    ],
    "importPaths": [
        "source"
    ],
    "toolchainRequirements": {
        "dmd": ">=2.111.0",
        "ldc": ">=1.41.0"
    },
    "buildTypes": {
        "profile-fp": {
            "buildOptions": [
                "debugMode",
                "debugInfo",
                "optimize"
            ],
            "dflags-dmd": [
                "-gs"
            ],
            "dflags-ldc": [
                "--frame-pointer=all"
            ]
        },
        "perf": {
            "buildOptions": [
                "releaseMode",
                "optimize",
                "inline"
            ],
            "versions": [
                "PerfProbe"
            ]
        },
        "perf-count": {
            "buildOptions": [
                "debugMode",
                "debugInfo"
            ],
            "versions": [
                "PerfProbe"
            ]
        },
        "perf-unit": {
            "buildOptions": [
                "unittests",
                "debugMode",
                "debugInfo"
            ],
            "versions": [
                "PerfProbe"
            ]
        },
        "check": {
            "buildOptions": [
                "debugMode",
                "debugInfo"
            ],
            "dflags-ldc": [
                "--boundscheck=on",
                "--checkaction=C",
                "--frame-pointer=all"
            ],
            "versions": [
                "SanitizerSelfTest"
            ]
        },
        "check-unit": {
            "buildOptions": [
                "unittests",
                "debugMode",
                "debugInfo"
            ],
            "dflags-ldc": [
                "--boundscheck=on",
                "--frame-pointer=all"
            ],
            "versions": [
                "SanitizerSelfTest"
            ]
        },
        "check-release": {
            "buildOptions": [
                "releaseMode",
                "optimize",
                "inline",
                "debugInfo"
            ],
            "dflags-ldc": [
                "--boundscheck=on",
                "--frame-pointer=all"
            ],
            "versions": [
                "SanitizerSelfTest"
            ]
        },
        "sanitize": {
            "buildOptions": [
                "debugMode",
                "debugInfo"
            ],
            "dflags-ldc": [
                "--fsanitize=address",
                "--fsanitize-address-use-after-return=never",
                "--checkaction=C",
                "--frame-pointer=all"
            ],
            "versions": [
                "SanitizerSelfTest"
            ]
        },
        "sanitize-unit": {
            "buildOptions": [
                "unittests",
                "debugMode",
                "debugInfo"
            ],
            "dflags-ldc": [
                "--fsanitize=address",
                "--fsanitize-address-use-after-return=never",
                "--frame-pointer=all"
            ],
            "versions": [
                "SanitizerSelfTest"
            ]
        },
        "tsan": {
            "buildOptions": [
                "debugMode",
                "debugInfo"
            ],
            "dflags-ldc": [
                "--fsanitize=thread",
                "--enable-asserts=false",
                "--frame-pointer=all"
            ],
            "versions": [
                "SanitizerSelfTest",
                "SanitizerThreadPreinit"
            ]
        }
    },
    "dependencies": {
        "vibe3d-interchange": {
            "path": "../interchange"
        },
        "vibe3d-log": {
            "path": "../../util/log"
        }
    },
    "configurations": [
        {
            "name": "modeling",
            "versions": [
                "WithAI"
            ],
            "subConfigurations": {
                "vibe3d-interchange": "modeling",
                "vibe3d-log": "modeling"
            }
        },
        {
            "name": "modeling-noai",
            "versions": [],
            "subConfigurations": {
                "vibe3d-interchange": "modeling-noai",
                "vibe3d-log": "modeling-noai"
            }
        },
        {
            "name": "with-render",
            "versions": [
                "WithRender",
                "WithAI"
            ],
            "subConfigurations": {
                "vibe3d-interchange": "with-render",
                "vibe3d-log": "with-render"
            }
        },
        {
            "name": "web",
            "versions": [
                "web"
            ],
            "subConfigurations": {
                "vibe3d-interchange": "web",
                "vibe3d-log": "web"
            },
            "excludedSourceFiles": [
                "source/ai3d/job_controller.d",
                "source/ai3d/stage_artifact.d",
                "source/ai3d/worker_manager.d"
            ]
        },
        {
            "name": "root-tests",
            "versions": [
                "WithAI",
                "MeshSnapshotFixtures"
            ],
            "subConfigurations": {
                "vibe3d-interchange": "root-tests",
                "vibe3d-log": "root-tests"
            },
            "targetType": "sourceLibrary"
        },
        {
            "name": "isolated-tests",
            "versions": [],
            "subConfigurations": {
                "vibe3d-interchange": "isolated-tests",
                "vibe3d-log": "isolated-tests"
            },
            "targetType": "sourceLibrary"
        }
    ]
}
