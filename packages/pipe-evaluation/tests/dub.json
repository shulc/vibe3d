{
    "name": "vibe3d-pipe-evaluation-tests",
    "license": "MIT",
    "targetType": "executable",
    "sourcePaths": [
        "../source"
    ],
    "importPaths": [
        "source",
        "../source"
    ],
    "sourceFiles": [
        "source/tests/unit/toolpipe/obbox_test.d",
        "source/tests/unit/toolpipe/pipeline_order_test.d",
        "source/tests/unit/toolpipe/stages/actcenter_test.d",
        "source/tests/unit/toolpipe/stages/axis_test.d",
        "source/tests/unit/toolpipe/stages/falloff_test.d",
        "source/tests/unit/toolpipe/stages/snap_test.d",
        "source/tests/unit/toolpipe/stages/symmetry_test.d",
        "source/tests/unit/toolpipe/stages/workplane_test.d",
        "source/tests/unit/toolpipe/obbox_regression_test.d",
        "source/tests/unit/toolpipe/prepared_stage_regression_test.d",
        "source/tests/unit/toolpipe/snap_stage_regression_test.d"
    ],
    "dependencies": {
        "vibe3d-common": {
            "path": "../../common"
        },
        "vibe3d-interaction-query": {
            "path": "../../interaction-query"
        }
    },
    "subConfigurations": {
        "vibe3d-common": "modeling-noai",
        "vibe3d-interaction-query": "modeling-noai"
    },
    "toolchainRequirements": {
        "dmd": ">=2.111.0",
        "ldc": ">=1.41.0"
    },
    "buildTypes": {
        "profile-fp": {
            "buildOptions": [
                "debugMode",
                "debugInfo",
                "optimize"
            ],
            "dflags-dmd": [
                "-gs"
            ],
            "dflags-ldc": [
                "--frame-pointer=all"
            ]
        },
        "perf": {
            "buildOptions": [
                "releaseMode",
                "optimize",
                "inline"
            ],
            "versions": [
                "PerfProbe"
            ]
        },
        "perf-count": {
            "buildOptions": [
                "debugMode",
                "debugInfo"
            ],
            "versions": [
                "PerfProbe"
            ]
        },
        "perf-unit": {
            "buildOptions": [
                "debugMode",
                "debugInfo",
                "unittests"
            ],
            "versions": [
                "PerfProbe"
            ]
        },
        "check": {
            "buildOptions": [
                "debugMode",
                "debugInfo"
            ],
            "dflags-ldc": [
                "--boundscheck=on",
                "--checkaction=C",
                "--frame-pointer=all"
            ],
            "versions": [
                "SanitizerSelfTest"
            ]
        },
        "check-unit": {
            "buildOptions": [
                "debugMode",
                "debugInfo",
                "unittests"
            ],
            "dflags-ldc": [
                "--boundscheck=on",
                "--frame-pointer=all"
            ],
            "versions": [
                "SanitizerSelfTest"
            ]
        },
        "check-release": {
            "buildOptions": [
                "releaseMode",
                "optimize",
                "inline",
                "debugInfo"
            ],
            "dflags-ldc": [
                "--boundscheck=on",
                "--frame-pointer=all"
            ],
            "versions": [
                "SanitizerSelfTest"
            ]
        },
        "sanitize": {
            "buildOptions": [
                "debugMode",
                "debugInfo"
            ],
            "dflags-ldc": [
                "--fsanitize=address",
                "--fsanitize-address-use-after-return=never",
                "--checkaction=C",
                "--frame-pointer=all"
            ],
            "versions": [
                "SanitizerSelfTest"
            ]
        },
        "sanitize-unit": {
            "buildOptions": [
                "debugMode",
                "debugInfo",
                "unittests"
            ],
            "dflags-ldc": [
                "--fsanitize=address",
                "--fsanitize-address-use-after-return=never",
                "--frame-pointer=all"
            ],
            "versions": [
                "SanitizerSelfTest"
            ]
        },
        "tsan": {
            "buildOptions": [
                "debugMode",
                "debugInfo"
            ],
            "dflags-ldc": [
                "--fsanitize=thread",
                "--enable-asserts=false",
                "--frame-pointer=all"
            ],
            "versions": [
                "SanitizerSelfTest",
                "SanitizerThreadPreinit"
            ]
        }
    },
    "configurations": [
        {
            "name": "evaluation"
        }
    ]
}
