{
  "name": "vibe3d-mesh-tests",
  "targetType": "executable",
  "toolchainRequirements": {
    "dmd": ">=2.111.0",
    "ldc": ">=1.41.0"
  },
  "buildTypes": {
    "profile-fp": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "optimize"
      ],
      "dflags-dmd": [
        "-gs"
      ],
      "dflags-ldc": [
        "--frame-pointer=all"
      ]
    },
    "perf": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "perf-count": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "perf-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "unittests"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "check": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--checkaction=C",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "check-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "unittests"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "check-release": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "sanitize": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--fsanitize=address",
        "--fsanitize-address-use-after-return=never",
        "--checkaction=C",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "sanitize-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "unittests"
      ],
      "dflags-ldc": [
        "--fsanitize=address",
        "--fsanitize-address-use-after-return=never",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "tsan": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--fsanitize=thread",
        "--enable-asserts=false",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest",
        "SanitizerThreadPreinit"
      ]
    }
  },
  "sourcePaths": [],
  "sourceFiles": [
    "../source/mesh.d",
    "../source/mesh_morph.d",
    "../source/mesh_planes.d",
    "../source/mesh_selsets.d",
    "source/tests/unit/mesh_key_test.d",
    "source/tests/unit/mesh_map_kind_test.d",
    "source/tests/unit/mesh_selsets_test.d",
    "source/tests/unit/mesh_topology_integration_test.d"
  ],
  "importPaths": [
    "../source",
    "source"
  ],
  "dflags": [],
  "dependencies": {
    "vibe3d:math": {"path": "../../.."},
    "vibe3d-spatial": {
      "path": "../../spatial"
    },
    "vibe3d-parallel": {
      "path": "../../../util/parallel"
    },
    "vibe3d-profiling": {
      "path": "../../profiling"
    },
    "vibe3d-edit-contracts": {
      "path": "../../edit-contracts"
    },
    "vibe3d-mesh-contracts": {
      "path": "../../mesh-contracts"
    },
    "vibe3d-mesh-topology": {
      "path": "../../mesh-topology"
    },
    "vibe3d-mesh-change": {
      "path": "../../mesh-change"
    },
    "vibe3d-mesh-edit-log": {
      "path": "../../mesh-edit-log"
    }
  },
  "configurations": [
    {
      "name": "algorithm",
      "subConfigurations": {
        "vibe3d:math": "isolated-tests",
        "vibe3d-spatial": "isolated-tests",
        "vibe3d-parallel": "isolated-tests",
        "vibe3d-profiling": "isolated-tests",
        "vibe3d-edit-contracts": "isolated-tests",
        "vibe3d-mesh-contracts": "isolated-tests",
        "vibe3d-mesh-topology": "isolated-tests",
        "vibe3d-mesh-change": "isolated-tests",
        "vibe3d-mesh-edit-log": "isolated-tests"
      }
    }
  ]
}
