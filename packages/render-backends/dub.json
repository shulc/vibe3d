{
  "targetType": "staticLibrary",
  "sourcePaths": [
    "source"
  ],
  "toolchainRequirements": {
    "dmd": ">=2.111.0",
    "ldc": ">=1.41.0"
  },
  "buildTypes": {
    "profile-fp": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "optimize"
      ],
      "dflags-dmd": [
        "-gs"
      ],
      "dflags-ldc": [
        "--frame-pointer=all"
      ]
    },
    "perf": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "perf-count": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "perf-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "unittests"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "check": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--checkaction=C",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "check-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "unittests"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "check-release": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "sanitize": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--fsanitize=address",
        "--fsanitize-address-use-after-return=never",
        "--checkaction=C",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "sanitize-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "unittests"
      ],
      "dflags-ldc": [
        "--fsanitize=address",
        "--fsanitize-address-use-after-return=never",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "tsan": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--fsanitize=thread",
        "--enable-asserts=false",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest",
        "SanitizerThreadPreinit"
      ]
    }
  },
  "name": "vibe3d-render-backends",
  "dependencies": {
    "vibe3d-input-events": {
      "path": "../../packages/input-events"
    },
    "vibe3d-log": {
      "path": "../../util/log"
    },
    "vibe3d-math": {
      "path": "../../util/math"
    },
    "vibe3d-render-model": {
      "path": "../../packages/render-model"
    },
    "bindbc-sdl": "~>1.5.2",
    "bindbc-opengl": "~>1.1.1"
  },
  "versions": [
    "SDL_2020",
    "GL_33"
  ],
  "configurations": [
    {
      "name": "modeling",
      "versions": [
        "WithAI"
      ],
      "subConfigurations": {
        "vibe3d-input-events": "modeling",
        "vibe3d-log": "modeling",
        "vibe3d-math": "modeling",
        "vibe3d-render-model": "modeling"
      }
    },
    {
      "name": "modeling-noai",
      "versions": [],
      "subConfigurations": {
        "vibe3d-input-events": "modeling-noai",
        "vibe3d-log": "modeling-noai",
        "vibe3d-math": "modeling-noai",
        "vibe3d-render-model": "modeling-noai"
      }
    },
    {
      "name": "with-render",
      "versions": [
        "WithRender",
        "WithAI"
      ],
      "subConfigurations": {
        "vibe3d-input-events": "with-render",
        "vibe3d-log": "with-render",
        "vibe3d-math": "with-render",
        "vibe3d-render-model": "with-render"
      },
      "dependencies": {
        "d-cycles": {
          "version": "a69f99794fab25b4902e0523052e5c4b6bef0941",
          "repository": "git+https://github.com/shulc/D-Cycles.git"
        },
        "bindbc-rpr": {
          "version": "d1a0a786c307207df3d50db809490c7030bd5927",
          "repository": "git+https://github.com/shulc/D-RadeonProRender.git"
        }
      }
    },
    {
      "name": "web",
      "versions": [
        "web"
      ],
      "subConfigurations": {
        "vibe3d-input-events": "web",
        "vibe3d-log": "web",
        "vibe3d-math": "web",
        "vibe3d-render-model": "web",
        "bindbc-sdl": "static",
        "bindbc-opengl": "static"
      }
    },
    {
      "name": "root-tests",
      "versions": [
        "WithAI"
      ],
      "subConfigurations": {
        "vibe3d-input-events": "root-tests",
        "vibe3d-log": "root-tests",
        "vibe3d-math": "root-tests",
        "vibe3d-render-model": "root-tests"
      },
      "targetType": "sourceLibrary"
    },
    {
      "name": "isolated-tests",
      "versions": [
        "WithRender"
      ],
      "subConfigurations": {
        "vibe3d-input-events": "isolated-tests",
        "vibe3d-log": "isolated-tests",
        "vibe3d-math": "isolated-tests",
        "vibe3d-render-model": "isolated-tests"
      },
      "targetType": "sourceLibrary",
      "dependencies": {
        "d-cycles": {
          "version": "a69f99794fab25b4902e0523052e5c4b6bef0941",
          "repository": "git+https://github.com/shulc/D-Cycles.git"
        },
        "bindbc-rpr": {
          "version": "d1a0a786c307207df3d50db809490c7030bd5927",
          "repository": "git+https://github.com/shulc/D-RadeonProRender.git"
        }
      }
    }
  ]
}
