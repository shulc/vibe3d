            "path": "../mesh-change"
        },
        "vibe3d-pipe-contracts": {
            "path": "../pipe-contracts"
        },
        "vibe3d-spatial": {
            "path": "../spatial"
        },
        "vibe3d-viewport-gpu": {
            "path": "../viewport-gpu"
        },
        "bindbc-opengl": "~>1.1.1"
    },
    "versions": [
