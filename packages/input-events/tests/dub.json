{
  "name": "vibe3d-input-events-tests",
  "targetType": "executable",
  "sourcePaths": [],
  "toolchainRequirements": {
    "dmd": ">=2.111.0",
    "ldc": ">=1.41.0"
  },
  "buildTypes": {
    "profile-fp": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "optimize"
      ],
      "dflags-dmd": [
        "-gs"
      ],
      "dflags-ldc": [
        "--frame-pointer=all"
      ]
    },
    "perf": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "perf-count": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "perf-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "unittests"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "check": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--checkaction=C",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "check-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "unittests"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "check-release": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "sanitize": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--fsanitize=address",
        "--fsanitize-address-use-after-return=never",
        "--checkaction=C",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "sanitize-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "unittests"
      ],
      "dflags-ldc": [
        "--fsanitize=address",
        "--fsanitize-address-use-after-return=never",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "tsan": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--fsanitize=thread",
        "--enable-asserts=false",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest",
        "SanitizerThreadPreinit"
      ]
    }
  },
  "dependencies": {
    "bindbc-sdl": "~>1.5.2",
    "dyaml": {
      "version": "22e4724474795eefb64ee9742f980b49bb34f6ef",
      "repository": "git+https://github.com/shulc/D-YAML.git"
    },
    "vibe3d-log": {
      "path": "../../../util/log"
    }
  },
  "versions": [
    "SDL_2020"
  ],
  "importPaths": [
    "source",
    "../source"
  ],
  "configurations": [
    {
      "name": "algorithm",
      "subConfigurations": {
        "vibe3d-log": "isolated-tests"
      }
    }
  ],
  "sourceFiles": [
    "../source/eventlog.d",
    "../source/held_gesture_buttons.d",
    "../source/input_context.d",
    "../source/input_zones.d",
    "../source/sdl_error.d",
    "../source/shortcuts.d",
    "../source/tool_input.d",
    "source/tests/unit/binding_resolve_test.d",
    "source/tests/unit/eventlog_parser_test.d",
    "source/tests/unit/eventlog_test.d",
    "source/tests/unit/input_events_population_test.d",
    "source/tests/unit/sdl_error_test.d",
    "source/tests/unit/tool_input_test.d"
  ],
  "workingDirectory": "../../../",
  "dflags": []
}
