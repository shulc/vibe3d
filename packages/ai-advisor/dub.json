{
    "name": "vibe3d-ai-advisor",
    "targetType": "staticLibrary",
    "sourcePaths": [
        "source"
    ],
    "importPaths": [
        "source"
    ],
    "toolchainRequirements": {
        "dmd": ">=2.111.0",
        "ldc": ">=1.41.0"
    },
    "buildTypes": {
        "profile-fp": {
            "buildOptions": [
                "debugMode",
                "debugInfo",
                "optimize"
            ],
            "dflags-dmd": [
                "-gs"
            ],
            "dflags-ldc": [
                "--frame-pointer=all"
            ]
        },
        "perf": {
            "buildOptions": [
                "releaseMode",
                "optimize",
                "inline"
            ],
            "versions": [
                "PerfProbe"
            ]
        },
        "perf-count": {
            "buildOptions": [
                "debugMode",
                "debugInfo"
            ],
            "versions": [
                "PerfProbe"
            ]
        },
        "perf-unit": {
            "buildOptions": [
                "unittests",
                "debugMode",
                "debugInfo"
            ],
            "versions": [
                "PerfProbe"
            ]
        },
        "check": {
            "buildOptions": [
                "debugMode",
                "debugInfo"
            ],
            "dflags-ldc": [
                "--boundscheck=on",
                "--checkaction=C",
                "--frame-pointer=all"
            ],
            "versions": [
                "SanitizerSelfTest"
            ]
        },
        "check-unit": {
            "buildOptions": [
                "unittests",
                "debugMode",
                "debugInfo"
            ],
            "dflags-ldc": [
                "--boundscheck=on",
                "--frame-pointer=all"
            ],
            "versions": [
                "SanitizerSelfTest"
            ]
        },
        "check-release": {
            "buildOptions": [
                "releaseMode",
                "optimize",
                "inline",
                "debugInfo"
            ],
            "dflags-ldc": [
                "--boundscheck=on",
                "--frame-pointer=all"
            ],
            "versions": [
                "SanitizerSelfTest"
            ]
        },
        "sanitize": {
            "buildOptions": [
                "debugMode",
                "debugInfo"
            ],
            "dflags-ldc": [
                "--fsanitize=address",
                "--fsanitize-address-use-after-return=never",
                "--checkaction=C",
                "--frame-pointer=all"
            ],
            "versions": [
                "SanitizerSelfTest"
            ]
        },
        "sanitize-unit": {
            "buildOptions": [
                "unittests",
                "debugMode",
                "debugInfo"
            ],
            "dflags-ldc": [
                "--fsanitize=address",
                "--fsanitize-address-use-after-return=never",
                "--frame-pointer=all"
            ],
            "versions": [
                "SanitizerSelfTest"
            ]
        },
        "tsan": {
            "buildOptions": [
                "debugMode",
                "debugInfo"
            ],
            "dflags-ldc": [
                "--fsanitize=thread",
                "--enable-asserts=false",
                "--frame-pointer=all"
            ],
            "versions": [
                "SanitizerSelfTest",
                "SanitizerThreadPreinit"
            ]
        }
    },
    "dependencies": {
        "vibe3d-interaction-data": {
            "path": "../interaction-data"
        },
        "vibe3d-math": {
            "path": "../../util/math"
        },
        "vibe3d-mesh": {
            "path": "../mesh"
        },
        "vibe3d-mesh-ops": {
            "path": "../mesh-ops"
        },
        "vibe3d-pipe-evaluation": {
            "path": "../pipe-evaluation"
        }
    },
    "configurations": [
        {
            "name": "modeling",
            "versions": [
                "WithAI"
            ],
            "subConfigurations": {
                "vibe3d-interaction-data": "modeling",
                "vibe3d-math": "modeling",
                "vibe3d-mesh": "modeling",
                "vibe3d-mesh-ops": "modeling",
                "vibe3d-pipe-evaluation": "modeling"
            },
            "dependencies": {
                "d-onnxruntime": {
                    "version": "3603828c1f5a6cd36817492252e1efb9c81e7ca4",
                    "repository": "git+https://github.com/shulc/D-OnnxRuntime.git"
                }
            }
        },
        {
