{
  "name": "vibe3d-http-runtime-tests",
  "targetType": "executable",
  "sourcePaths": [],
  "sourceFiles": [
    "../source/http_server.d",
    "../source/http_transport.d",
    "../source/playback_controller.d"
  ],
  "importPaths": [
    "source",
    "../source"
  ],
  "toolchainRequirements": {
    "dmd": ">=2.111.0",
    "ldc": ">=1.41.0"
  },
  "buildTypes": {
    "profile-fp": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "optimize"
      ],
      "dflags-dmd": [
        "-gs"
      ],
      "dflags-ldc": [
        "--frame-pointer=all"
      ]
    },
    "perf": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "perf-count": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "perf-unit": {
      "buildOptions": [
        "unittests",
        "debugMode",
        "debugInfo"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "check": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--checkaction=C",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "check-unit": {
      "buildOptions": [
        "unittests",
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "check-release": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "sanitize": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--fsanitize=address",
        "--fsanitize-address-use-after-return=never",
        "--checkaction=C",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "sanitize-unit": {
      "buildOptions": [
        "unittests",
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--fsanitize=address",
        "--fsanitize-address-use-after-return=never",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "tsan": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--fsanitize=thread",
        "--enable-asserts=false",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest",
        "SanitizerThreadPreinit"
      ]
    }
  },
  "dependencies": {
    "vibe3d-application-core": {
      "path": "../../application-core"
    },
    "vibe3d:edit-contracts": {
      "path": "../../.."
    },
    "vibe3d:input-events": {
      "path": "../../.."
    },
    "vibe3d-interaction-query": {
      "path": "../../interaction-query"
    },
    "vibe3d:log": {
      "path": "../../.."
    },
    "vibe3d:mesh": {
      "path": "../../.."
    },
    "vibe3d:mesh-change": {
      "path": "../../.."
    },
    "vibe3d:param-schema": {
      "path": "../../.."
    },
    "vibe3d-pipe-evaluation": {
      "path": "../../pipe-evaluation"
    },
    "vibe3d:profiling": {
      "path": "../../.."
    }
  },
  "dflags": [],
  "configurations": [
    {
      "name": "algorithm",
      "subConfigurations": {
        "vibe3d-application-core": "isolated-tests",
        "vibe3d:edit-contracts": "isolated-tests",
        "vibe3d:input-events": "isolated-tests",
        "vibe3d-interaction-query": "isolated-tests",
        "vibe3d:log": "isolated-tests",
        "vibe3d:mesh": "isolated-tests",
        "vibe3d:mesh-change": "isolated-tests",
        "vibe3d:param-schema": "isolated-tests",
        "vibe3d-pipe-evaluation": "isolated-tests",
        "vibe3d:profiling": "isolated-tests"
      }
    }
  ]
}
