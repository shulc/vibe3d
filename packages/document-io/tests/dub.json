{
  "name": "vibe3d-document-io-tests",
  "targetType": "executable",
  "sourcePaths": [],
  "toolchainRequirements": {
    "dmd": ">=2.111.0",
    "ldc": ">=1.41.0"
  },
  "buildTypes": {
    "profile-fp": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "optimize"
      ],
      "dflags-dmd": [
        "-gs"
      ],
      "dflags-ldc": [
        "--frame-pointer=all"
      ]
    },
    "perf": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "perf-count": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "perf-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "unittests"
      ],
      "versions": [
        "PerfProbe"
      ]
    },
    "check": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--checkaction=C",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "check-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "unittests"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "check-release": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--boundscheck=on",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "sanitize": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--fsanitize=address",
        "--fsanitize-address-use-after-return=never",
        "--checkaction=C",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "sanitize-unit": {
      "buildOptions": [
        "debugMode",
        "debugInfo",
        "unittests"
      ],
      "dflags-ldc": [
        "--fsanitize=address",
        "--fsanitize-address-use-after-return=never",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest"
      ]
    },
    "tsan": {
      "buildOptions": [
        "debugMode",
        "debugInfo"
      ],
      "dflags-ldc": [
        "--fsanitize=thread",
        "--enable-asserts=false",
        "--frame-pointer=all"
      ],
      "versions": [
        "SanitizerSelfTest",
        "SanitizerThreadPreinit"
      ]
    }
  },
  "dependencies": {
    "vibe3d-document-model": {
      "path": "../../document-model"
    },
    "vibe3d-document-channels": {
      "path": "../../document-channels"
    },
    "vibe3d:param-schema": {
      "path": "../../.."
    },
    "vibe3d-mesh": {
      "path": "../../mesh"
    },
    "vibe3d:spatial": {
      "path": "../../.."
    },
    "vibe3d:math": {
      "path": "../../.."
    },
    "vibe3d:edit-contracts": {
      "path": "../../.."
    },
    "vibe3d:log": {
      "path": "../../.."
    },
    "vibe3d-image-codec": {
      "path": "../../image-codec"
    }
  },
  "importPaths": [
    "source",
    "../source"
  ],
  "configurations": [
    {
      "name": "algorithm",
      "subConfigurations": {
        "vibe3d-document-model": "isolated-tests",
        "vibe3d-document-channels": "isolated-tests",
        "vibe3d:param-schema": "isolated-tests",
        "vibe3d-mesh": "isolated-tests",
        "vibe3d:spatial": "isolated-tests",
        "vibe3d:math": "isolated-tests",
        "vibe3d:edit-contracts": "isolated-tests",
        "vibe3d:log": "isolated-tests",
        "vibe3d-image-codec": "isolated-tests"
      }
    }
  ],
  "sourceFiles": [
    "../source/io/file_model.d",
    "../source/io/image_path.d",
    "../source/io/native.d",
    "source/tests/unit/document_io_population_test.d",
    "source/tests/unit/io/image_path_test.d",
    "source/tests/unit/io/native_source_cells_test.d",
    "source/tests/unit/io/native_test.d"
  ],
  "dflags": []
}
