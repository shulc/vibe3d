 },
 "law": {
  "duplicator_scope": "PER-COPY: the vertices of copy k weld (within the weld distance) only to vertices that existed before copy k was made -- the whole mesh as it stood plus earlier copies -- never to vertices of the same copy; the earlier vertex survives in place. With one copy (count 2, mirror) this is CROSS-BOUND.",
  "comparison": "inclusive at the user distance (vertex merge 0.5 apart welds); a distance of 0 still welds pairs <= 5e-10 apart",
  "cleanup": "no user distance; fixed absolute threshold between 1e-9 (welds) and 1.01e-9 (does not); identical to the automatic-range vertex merge"
