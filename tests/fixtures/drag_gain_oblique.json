{
 "description": "Axis-handle drag gain, measured on oblique cameras. For a press on a translate gizmo axis arm, the world displacement along that axis is the view's world-per-pixel size times the drag's component along the axis's SCREEN projection, with no foreshortening term, rounded to the nearest multiple of the view's coordinate-rounding step.",
 "law": {
  "gain": "t_raw = pixel_size * dot(drag_px, unit_screen_dir(axis))",
  "quantum": "q = nice_step_ceil({1,2,5,10}, pixel_size)",
  "snap": "t = round_half_away_from_zero(t_raw / q) * q",
  "result": "world_delta = t * axis  (the other two components are 0)"
 },
