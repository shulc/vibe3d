    "cornerHistogram": "face count by corner count",
    "splitShared": "the split vertex is a corner of a face with at least three corners",
    "holdersOfPair": "surface faces containing both endpoints of the short face",
    "endpointsStay": "the original two-corner endpoints remain at their pre-door positions",
    "cornerStays": "a corner of no selected face with three or more corners remains at its pre-door position",
    "isSubpatch": "model.isSubpatch",
