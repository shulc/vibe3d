 "conventions": {
  "plane_basis": "B = Rz(rz) * Rx(rx) * Ry(ry); world = origin + B * local; local Y is the plane normal",
  "rig_cube": "+-0.5, vertex index = 4*(x>0) + 2*(y>0) + (z>0); faces [1,5,7,3] (+Z, index 0), [0,2,6,4], [4,6,7,5], [0,1,3,2], [2,3,7,6], [0,4,5,1]",
  "view_frame": "with a pinned plane every viewport read (focus, orientation, pixel->point) is in plane-local coordinates; an orthographic view is re-expressed in the plane's frame, so it turns with the plane"
 },
 "laws": {
  "placement": "the gesture point is computed in PLANE-LOCAL view coordinates (ray through the pixel, meeting the local principal plane whose axis is the largest component of the local view direction, through the grid-rounded local camera focus) and written to the channels; world = origin + B * channels. The primitive therefore lies on the ray of the pixel it was placed at (cylinder/sphere: the press pixel = centre; box: the release pixel = centre, press = corner). d_perp <= snap quantum in every cell.",
  "motionless_click": "writes the channels, size 0, and creates no geometry",
  "orientation": "the primitive is axis-aligned in the plane frame (typed oblique plane, two non-zero angles)"
 },
