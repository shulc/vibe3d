 "laws": [
  {
   "id": "L1-own-activation",
   "cells": [
    "arm-two-moves"
   ],
   "law": "Armed through the key/UI door, the activation is its own undo step: each Ctrl+Z pops exactly one gesture and the tool stays armed; the Ctrl+Z after the last gesture pops the activation and drops the tool."
  },
  {
   "id": "L2-redo-symmetric",
   "cells": [
    "arm-two-moves"
   ],
   "law": "Redo after popping the activation re-arms the tool bare, then re-applies each gesture bit-exact."
  },
  {
   "id": "L4-every-chord-one-step",
   "cells": [
    "chords"
   ],
   "law": "Every chord gesture is exactly one Ctrl+Z step; the undo restores the pre-gesture mesh bit-exact and the tool stays armed; redo of split/remove restores the gesture bit-exact."
  },
  {
   "id": "L5-press-is-a-step",
   "cells": [
    "no-op-presses"
   ],
   "law": "Every press writes one undo step even when the mesh does not change; Ctrl+Z pops such a step and the tool stays armed."
  },
  {
   "id": "L6-held-key-dropped",
   "cells": [
    "held-undo"
   ],
   "law": "A Ctrl+Z pressed while the button of a Move drag is held is dropped; the drag completes and afterwards two gestures are on the stack."
  },
  {
   "id": "L9-switch-keeps-gesture",
   "cells": [
    "switch-away"
   ],
   "law": "Switching to another tool keeps the gesture; one Ctrl+Z pops the new tool's activation and re-arms the pen with the gesture intact; the next pops the gesture, the next the pen's activation; redo is symmetric."
  },
  {
   "id": "L10-branch-replace",
   "cells": [
    "branch"
   ],
   "law": "A gesture after an undo discards the redo branch: after g1, g2, Ctrl+Z, g3 the next Ctrl+Z pops g3, the next g1."
  },
  {
   "id": "L12-alt-never-reaches-tool",
   "cells": [
    "alt-chords"
   ],
   "law": "No Alt chord reaches the pen: Alt drags started on a vertex leave the mesh bit-identical, add no undo step, and the tool stays armed."
  },
  {
   "id": "L13-smooth-loop-is-the-loop",
   "cells": [
    "smooth-loop"
   ],
   "law": "Smoothing + Edge Loop processes only the pressed edge's loop: on an interior edge of an open 4-vertex row the two interior vertices; on a border edge the perimeter minus its four face-valence-1 corners. Plain smoothing on the same edge moves all 16. One step each, undo bit-exact."
  }
 ],
