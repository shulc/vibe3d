 "laws": [
  {
   "id": "L1-own-activation",
   "cells": [
    "arm-two-moves"
   ],
   "law": "Armed through the key/UI door, the activation is its own undo step: each Ctrl+Z pops exactly one gesture and the tool stays armed; the Ctrl+Z after the last gesture pops the activation and drops the tool."
  },
  {
   "id": "L2-redo-symmetric",
   "cells": [
    "arm-two-moves"
   ],
   "law": "Redo after popping the activation re-arms the tool bare, then re-applies each gesture bit-exact."
  },
  {
   "id": "L4-every-chord-one-step",
   "cells": [
    "chords"
   ],
   "law": "Every chord gesture is exactly one Ctrl+Z step; the undo restores the pre-gesture mesh bit-exact and the tool stays armed; redo of split/remove restores the gesture bit-exact."
  },
  {
   "id": "L5-press-is-a-step",
   "cells": [
    "no-op-presses",
    "no-op-chord-clicks"
   ],
   "law": "Every press writes one undo step even when the mesh does not change; Ctrl+Z pops such a step and the tool stays armed."
  },
  {
   "id": "L14-parameter-write-is-a-step",
   "cells": [
    "param-write-idle",
    "param-write-post-press",
    "param-write-show"
   ],
   "law": "An interactive attribute write on an armed pen is its own undo step, before or after a press; Ctrl+Z restores the prior value and keeps the geometry and the tool."
  },
  {
   "id": "L40-refused-split-is-a-step",
   "cells": [
    "split-far-row",
    "split-empty-release",
    "split-adjacent-row"
   ],
   "law": "A split refused at its release (a target sharing no polygon, an adjacent corner, empty space) changes nothing and is still one undo step; the next Ctrl+Z drops the tool."
  },
  {
   "id": "L6-held-key-dropped",
   "cells": [
    "held-undo"
   ],
   "law": "A Ctrl+Z pressed while the button of a Move drag is held is dropped; the drag completes and afterwards two gestures are on the stack."
  },
  {
   "id": "L9-switch-keeps-gesture",
   "cells": [
    "switch-away"
   ],
   "law": "Switching to another tool keeps the gesture; one Ctrl+Z pops the new tool's activation and re-arms the pen with the gesture intact; the next pops the gesture, the next the pen's activation; redo is symmetric."
  },
  {
   "id": "L10-branch-replace",
   "cells": [
    "branch"
   ],
   "law": "A gesture after an undo discards the redo branch: after g1, g2, Ctrl+Z, g3 the next Ctrl+Z pops g3, the next g1."
  },
  {
   "id": "L12-alt-never-reaches-tool",
   "cells": [
    "alt-chords"
   ],
   "law": "No Alt chord reaches the pen: Alt drags started on a vertex leave the mesh bit-identical, add no undo step, and the tool stays armed."
  },
  {
   "id": "L13-smooth-loop-is-the-loop",
   "cells": [
    "smooth-loop"
   ],
   "law": "Smoothing + Edge Loop processes only the pressed edge's loop: on an interior edge of an open 4-vertex row the two interior vertices; on a border edge the perimeter minus its four face-valence-1 corners. Plain smoothing on the same edge moves all 16. One step each, undo bit-exact."
  },
  {
   "id": "L34-build-neighbour-by-angle",
   "cells": [
    "chord-build"
   ],
   "law": "A drag-build from a vertex that takes ONE existing neighbour takes the border neighbour whose screen direction makes the smallest angle with the drag (B1a: v4, B1b: v1); on the bisector it takes v4 (K-chords)."
  },
  {
   "id": "L37-build-closed-and-in-triangle",
   "cells": [
    "chord-build"
   ],
   "law": "No build when every incident edge of the source lies on two polygons: the press moves the vertex (triangle over the corner quad). Otherwise a triangle corner builds a quad across its two border neighbours, the triangles kept (B5a, and B5b-far with the drag inside the covered wedge); a quad corner builds the triangle with the N-angle neighbour even with the drag inside the quad's wedge (B6a-big). One step each, undo bit-exact, the tool stays armed."
  },
  {
   "id": "L35-remove-drops-only-its-own-orphans",
   "cells": [
    "chord-remove-corner",
    "chord-remove-border",
    "chord-remove-leaves-loose"
   ],
   "law": "A face remove also deletes the vertices and edges THIS removal leaves with no polygon (corner f0: 15/8/22; border f1: the faceless border edge goes, 16/8/23), and nothing else: a vertex that belonged to no polygon before the remove survives it (19 -> 18). One step, undo bit-exact, the tool stays armed."
  },
  {
   "id": "L4-vertex-slide",
   "cells": [
    "chord-slide-vertex",
    "chord-slide-vertex-orbit",
    "chord-slide-vertex-foreshortened"
   ],
   "law": "A Ctrl+LMB press on a vertex slides that vertex alone, one channel, along the world axis whose screen image at the vertex is most parallel to the drag, skipping an axis seen nearly end-on (image shorter than a fraction of the longest), in the direction its image takes along the drag; not along any incident edge, nor the axis nearest the drag's world or view-plane direction. It re-places the vertex at its nearest point on the background: v = nearestBG(u + s e_axis); topology unchanged; one Ctrl+Z step, undo bit-exact, the tool stays armed."
  }
 ],
