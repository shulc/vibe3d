// 9504: captured edge/polygon product doors. Geometry and final corner order
// are copied from K-EE; population guards precede every result.
import drag_helpers : Vec3, buildDragLog, fetchCamera, playAndWait;
import pen_rig_helpers : penSceneEmpty, penCommand, penCameraAt, worldPixel;
import http_client : getJson, postJson;
import http_command_helpers : commandBody;
import std.json;
import std.math : abs;
import std.format : format;
import std.process : environment;
void main() {}
private void cell(string name,string input,string output,int count,float x,float y,bool sym,bool inner) {
    if(environment.get("VIBE3D_CELL","all")!="all" && environment.get("VIBE3D_CELL","all")!=name) return;
    penSceneEmpty("Front");
    assert(postJson("/api/command",commandBody("scene.loadMesh",input))["status"].str=="ok");
    penCommand("viewport.view Front"); penCameraAt(Vec3(0,0,0),100);
    penCommand("tool.set mesh.topoPen on");
    penCommand("tool.attr mesh.topoPen mode move");
    penCommand("tool.attr mesh.topoPen backFace true");
    penCommand("tool.attr mesh.topoPen innerSnap "~(inner?"true":"false"));
    penCommand("tool.pipe.attr snap types \"\"");
    penCommand("tool.pipe.attr symmetry axis x");
    penCommand("tool.pipe.attr symmetry enabled "~(sym?"true":"false"));
    auto before=getJson("/api/model"); auto original=parseJSON(input);
    assert(before["vertices"].array.length==original["vertices"].array.length && before["faces"].array.length==original["faces"].array.length,"edge fixture population");
    auto from=worldPixel(Vec3(x,y,0)); auto cam=fetchCamera();
    playAndWait(buildDragLog(cam.vpX,cam.vpY,cam.width,cam.height,from[0],from[1],from[0]+count*4,from[1],count,0,1));
    auto result=getJson("/api/model"); auto expected=parseJSON(output);
    assert(result["vertices"].array.length==expected["pos"].array.length,format("%s: captured vertex population expected %s got %s",name,expected["pos"].array.length,result["vertices"].array.length));
    foreach(i,v;expected["pos"].array) foreach(j;0..3) {
        const a=result["vertices"][i][j].type==JSONType.integer?cast(double)result["vertices"][i][j].integer:result["vertices"][i][j].floating;
        const b=v[j].type==JSONType.integer?cast(double)v[j].integer:v[j].floating;
        assert(abs(a-b)<0.00001,format("%s: captured vertex[%s][%s] expected %s got %s",name,i,j,b,a));
    }
    assert(result["faces"]==expected["faces"],name~": captured polygon corner order");
}
